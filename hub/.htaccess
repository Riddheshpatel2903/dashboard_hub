# Disable directory listings
Options -Indexes

# Protect .htaccess file
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Redirect or deny direct access to core internal directories and SQL files
RewriteEngine On
RewriteBase /hub/

# Prevent access to config, db, platforms, storage, jobs, logs, and utils directories
RewriteRule ^(config|db|platforms|storage|jobs|utils|logs)(/|$) - [F,L]

# Prevent access to schema.sql specifically if it was queried outside /db/
RewriteRule ^schema\.sql$ - [F,L]
